# OpenAI 兼容的 LLM 服务配置
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your-api-key-here
AI_MODEL=deepseek-chat

# 豆包语音（火山引擎 openspeech）2.0 —— 二选一：
# 新版控制台：一把 API Key 通吃
DOUBAO_API_KEY=your-api-key
# 旧版控制台：App ID + Access Token
# DOUBAO_APP_ID=your-app-id
# DOUBAO_ACCESS_TOKEN=your-access-token

# 可选配置（有默认值）
# DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration   # 并发版: volc.seedasr.sauc.concurrent
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0                  # 复刻音色: seed-icl-2.0
# DOUBAO_VOICE_TYPE=zh_female_vv_uranus_bigtts
# DOUBAO_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# DOUBAO_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
